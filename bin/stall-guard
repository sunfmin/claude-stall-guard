#!/usr/bin/env python3
"""
stall-guard — run a command under a PTY and detect when it stalls waiting
for interactive input, instead of hanging until the harness timeout.

Detection model ("progress" = new PTY output OR CPU time advancing in the
child's process group):

  - progress stopped AND the last output line looks like an interactive
    prompt                      -> stall after --prompt-idle seconds (def 10)
  - progress stopped, no recognizable prompt
                                -> stall after --idle seconds (def 30)
  - CPU-busy but silent (compiler, test run, ...) keeps making "progress"
    and is never killed.

On stall: the whole process group gets SIGTERM (then SIGKILL after 2s), a
clearly marked report is printed for Claude to read, and stall-guard exits
with code 99. Otherwise the child's exit code is passed through.

Usage:
  stall-guard -c 'npm init'                # command string via bash -c
  stall-guard -- python3 setup.py install  # argv form
Env overrides: STALL_GUARD_IDLE, STALL_GUARD_PROMPT_IDLE, STALL_GUARD_TERM
"""

import argparse
import os
import pty
import re
import select
import signal
import struct
import subprocess
import sys
import time

import fcntl
import termios

STALL_EXIT = 99
TAIL_BYTES = 4096
CPU_EPSILON = 0.02  # cputime seconds that count as "advancing"

ANSI_RE = re.compile(
    rb'\x1b\[[0-9;?]*[ -/]*[@-~]'            # CSI sequences
    rb'|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)'    # OSC sequences
    rb'|\x1b[@-_]'                            # other escapes
)

# Ordered: most specific first. Matched against the last non-empty,
# ANSI-stripped output line.
PROMPT_PATTERNS = [
    ('yes/no choice',
     re.compile(r'[\(\[](?:y(?:es)?\s*[/|]\s*no?|no?\s*[/|]\s*y(?:es)?)[\)\]]\s*[?:]?\s*$', re.I)),
    ('credential prompt',
     re.compile(r'(?:password|passphrase|username|user name|login|email|token|otp|2fa|pin|passcode)\b[^:]{0,20}:\s*$', re.I)),
    ('press-enter prompt',
     re.compile(r'(?:press|hit)\s+(?:any key|enter|return)', re.I)),
    ('confirmation request',
     re.compile(r'are you sure', re.I)),
    ('confirm keyword',
     re.compile(r'\b(?:ok to proceed|proceed|continue|overwrite|replace|confirm|trust)\b[^a-z]{0,10}$', re.I)),
    ('default-value prompt',          # e.g. npm init: "package name: (demo) "
     re.compile(r':\s*\([^)]*\)\s*$')),
    ('inquirer-style question',
     re.compile(r'^\?\s')),
    ('selector arrow',
     re.compile(r'[❯›]\s')),
    ('question mark',
     re.compile(r'\?\s*$')),
    ('REPL prompt',
     re.compile(r'^(?:>>>|\.\.\.|>|\$|#|%|In \[\d*\]:)\s*$')),
    ('shell prompt',
     re.compile(r'^[\w.@-]*[$#%]\s*$')),
    ('trailing colon/bracket',        # weakest; only fires when fully idle anyway
     re.compile(r'[:>]\s*$')),
]


def env_float(name, default):
    try:
        return float(os.environ.get(name, ''))
    except ValueError:
        return default


def tree_cputime(pgid):
    """Total accumulated CPU time of all processes in pgid, via ps (macOS/BSD)."""
    try:
        out = subprocess.run(['ps', '-ax', '-o', 'pgid=,time='],
                             capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return None
    total = 0.0
    target = str(pgid)
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0] == target:
            t = 0.0
            try:
                for field in parts[1].split(':'):
                    t = t * 60 + float(field.replace(',', '.'))
            except ValueError:
                t = 0.0
            total += t
    return total


def stripped_lines(tail):
    text = ANSI_RE.sub(b'', tail)
    text = text.replace(b'\r\n', b'\n').replace(b'\r', b'\n')
    return text.decode('utf-8', 'replace').split('\n')


def last_line(tail):
    for line in reversed(stripped_lines(tail)):
        line = line.strip()
        if line:
            return line
    return ''


def looks_like_prompt(line):
    if not line:
        return None
    for label, rx in PROMPT_PATTERNS:
        if rx.search(line):
            return label
    return None


def kill_group(pid):
    """SIGTERM the child's process group, give it 2s, then SIGKILL."""
    try:
        os.killpg(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    deadline = time.time() + 2.0
    while time.time() < deadline:
        try:
            if os.waitpid(pid, os.WNOHANG)[0] == pid:
                break
        except ChildProcessError:
            break
        time.sleep(0.1)
    try:
        os.killpg(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def stall(pid, tail, reason, idle_s):
    sys.stdout.flush()
    lines = [l for l in stripped_lines(tail) if l.strip()][-10:]
    rep = ['',
           '[stall-guard] ⛔ STALL DETECTED — command appears to be waiting for interactive input.',
           f'[stall-guard] reason: {reason} (no output and no CPU activity for {idle_s:.0f}s)',
           '[stall-guard] last output:']
    rep += [f'[stall-guard]   │ {l}' for l in lines] or ['[stall-guard]   │ (no output at all)']
    rep += [f'[stall-guard] process group terminated; exit code {STALL_EXIT}.',
            '[stall-guard] HINT for Claude: do NOT simply re-run this command. Instead:',
            '[stall-guard]   - use a non-interactive flag (-y / --yes / --non-interactive / CI=1 /',
            '[stall-guard]     DEBIAN_FRONTEND=noninteractive), or',
            '[stall-guard]   - pipe the answer in (`yes | cmd`, `printf "ans\\n" | cmd`), or',
            '[stall-guard]   - ask the user to run it manually in their own terminal (`! cmd`).']
    print('\n'.join(rep))
    sys.stdout.flush()
    kill_group(pid)
    try:
        os.waitpid(pid, 0)
    except ChildProcessError:
        pass
    sys.exit(STALL_EXIT)


def main():
    ap = argparse.ArgumentParser(prog='stall-guard', description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('-c', '--command', help='command string, run via bash -c')
    ap.add_argument('--idle', type=float, default=env_float('STALL_GUARD_IDLE', 30),
                    help='seconds of total inactivity before a generic stall (default 30)')
    ap.add_argument('--prompt-idle', type=float, default=env_float('STALL_GUARD_PROMPT_IDLE', 10),
                    help='seconds of inactivity when last line looks like a prompt (default 10)')
    ap.add_argument('--term', default=os.environ.get('STALL_GUARD_TERM', 'dumb'),
                    help='TERM for the child (default dumb: fewer spinners/ANSI)')
    ap.add_argument('argv', nargs='*', help='command and args (alternative to -c)')
    args = ap.parse_args()

    if args.command and args.argv:
        ap.error('use either -c or argv form, not both')
    if args.command:
        child_argv = ['bash', '-c', args.command]
    elif args.argv:
        child_argv = args.argv
    else:
        ap.error('no command given')

    pid, master = pty.fork()
    if pid == 0:  # child: gets the pty as controlling terminal + stdio
        os.environ['TERM'] = args.term
        os.environ['STALL_GUARD_ACTIVE'] = '1'
        try:
            os.execvp(child_argv[0], child_argv)
        except OSError as e:
            sys.stderr.write(f'stall-guard: exec {child_argv[0]!r} failed: {e}\n')
            os._exit(127)

    # parent
    fcntl.ioctl(master, termios.TIOCSWINSZ, struct.pack('HHHH', 40, 120, 0, 0))

    def forward(sig, _frame):
        try:
            os.killpg(pid, sig)
        except ProcessLookupError:
            pass
    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, forward)

    start = time.time()
    last_output = start
    last_cpu_adv = start
    last_cpu_sample = start
    cpu_seen = 0.0
    tail = b''
    child_status = None
    master_open = True

    while True:
        if master_open:
            try:
                r, _, _ = select.select([master], [], [], 0.5)
            except InterruptedError:
                continue
            if r:
                try:
                    data = os.read(master, 65536)
                except OSError:      # EIO on Linux when slave side closes
                    data = b''
                if data:
                    os.write(1, data)
                    tail = (tail + data)[-TAIL_BYTES:]
                    last_output = time.time()
                else:                # EOF: no process holds the slave anymore
                    master_open = False
        else:
            time.sleep(0.5)

        now = time.time()

        if child_status is None:
            try:
                done, status = os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                done, status = pid, 0
            if done == pid:
                child_status = status
        if child_status is not None and (not master_open or now - last_output > 0.3):
            break

        if now - last_cpu_sample >= 1.0:
            last_cpu_sample = now
            cpu = tree_cputime(pid)
            if cpu is not None and cpu > cpu_seen + CPU_EPSILON:
                cpu_seen = cpu
                last_cpu_adv = now

        idle = now - max(last_output, last_cpu_adv)
        if idle >= args.prompt_idle:
            label = looks_like_prompt(last_line(tail))
            if label:
                stall(pid, tail, f'last line looks like an interactive prompt [{label}]', idle)
        if idle >= args.idle:
            stall(pid, tail, 'no recognizable prompt, but the process went completely idle', idle)

    try:
        os.close(master)
    except OSError:
        pass
    if child_status is None:
        try:
            _, child_status = os.waitpid(pid, 0)
        except ChildProcessError:
            child_status = 0
    if os.WIFSIGNALED(child_status):
        sys.exit(128 + os.WTERMSIG(child_status))
    sys.exit(os.WEXITSTATUS(child_status))


if __name__ == '__main__':
    main()
